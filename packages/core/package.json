{
  "name": "@setu/core",
  "version": "1.0.0",
  "private": true,
  "description": "The SETU Cognitive Kernel — zero DOM dependencies at import time, zero React, zero network.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "happy-dom": "^15.11.7",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
