# Backend API URL (no trailing slash).
# In local development, leave blank: Vite's dev server proxies /api to http://localhost:3000.
# In production, set this when the frontend is hosted separately from the backend (e.g., Vercel CDN + Render API).
# Example: VITE_API_URL=https://setu-37hl.onrender.com
VITE_API_URL=
