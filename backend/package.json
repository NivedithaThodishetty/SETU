{
  "name": "setu-backend",
  "version": "3.0.0",
  "description": "SETU — shared AI orchestration engine for the Lens extension and Sanctuary web app",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node scripts/crisis-test.js && node scripts/reading-test.js && node scripts/test-ai-service.js && node scripts/test-agent-profile.js",
    "test:reading": "node scripts/reading-test.js",
    "test:crisis": "node scripts/crisis-test.js",
    "test:profile": "node scripts/test-agent-profile.js",
    "test:ai": "node scripts/test-ai-service.js",
    "smoke": "node scripts/smoke-test.js",
    "seed": "node scripts/seed-demo-data.js && node scripts/seed-reading-checks.js",
    "seed:reading": "node scripts/seed-reading-checks.js",
    "seed:reset": "node scripts/seed-demo-data.js --reset && node scripts/seed-reading-checks.js --reset",
    "seed:clean": "node scripts/seed-demo-data.js --clean && node scripts/seed-reading-checks.js --clean"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mammoth": "^1.12.1",
    "mongoose": "^9.9.2",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "keywords": [
    "accessibility",
    "adhd",
    "dyslexia",
    "neurodivergent",
    "ai"
  ],
  "author": "SETU Team",
  "license": "MIT"
}
